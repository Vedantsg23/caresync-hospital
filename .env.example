# ─────────────────────────────────────────────────────────────
# CareSync Hospital — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) -----------------------------------
# Works with Supabase, Neon, Vercel Postgres, or local Postgres.
# Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://user:password@host:5432/caresync?schema=public"
# Optional: direct (non-pooled) URL used for migrations on Supabase/Neon.
DIRECT_URL=""

# --- Session / Auth ------------------------------------------
# 32+ char random secret. Generate with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Session lifetime in seconds (default 8h — one hospital shift)
SESSION_MAX_AGE="28800"

# --- App -----------------------------------------------------
NEXT_PUBLIC_APP_NAME="CareSync Hospital"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Seeding -------------------------------------------------
# Password applied to every seeded demo account. DEV/DEMO ONLY.
SEED_DEMO_PASSWORD="CareSync#2026"
# Set to "true" to allow seeding a non-empty database (destructive).
SEED_FORCE="false"

# --- AI layer (optional) -------------------------------------
# Leave AI_PROVIDER=heuristic to run the deterministic, offline
# summariser. Set to "anthropic" or "openai" and supply a key to
# use a hosted model. AI output is always advisory + human-reviewed.
AI_PROVIDER="heuristic"
AI_API_KEY=""
AI_MODEL=""

# --- File storage --------------------------------------------
# "database" (default, portable) | "local" (dev filesystem) | "supabase"
STORAGE_DRIVER="database"
STORAGE_MAX_FILE_MB="10"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="caresync-documents"

# --- Rate limiting -------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN="10"
RATE_LIMIT_API_PER_MIN="300"

# --- Demonstration mode ---------------------------------------
# The login screen offers one-click demo accounts. Set to "false"
# for any deployment that is not a public demonstration.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="true"
NEXT_PUBLIC_DEMO_PASSWORD="CareSync#2026"

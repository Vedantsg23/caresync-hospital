# ─────────────────────────────────────────────────────────────
# CareSync Hospital — environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Only DATABASE_URL and AUTH_SECRET have no working default. Everything
# else below has one, and the defaults are the safe choice: mail is
# recorded rather than sent, rate limits are per-instance, the AI layer
# is the offline summariser, and no demo account exists.
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) -----------------------------------
# Works with Supabase, Neon, Vercel Postgres, or local Postgres.
DATABASE_URL="postgresql://user:password@host:5432/caresync?schema=public"
# Optional: direct (non-pooled) URL used for migrations on Supabase/Neon.
DIRECT_URL=""
# Pooled connections per instance. Keep this small — with serverless the
# database's connection ceiling is the constraint, not this process.
DB_POOL_MAX="5"

# --- Session / Auth ------------------------------------------
# 32+ char random secret. Generate with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
# Idle session lifetime in seconds (default 8h — one hospital shift).
SESSION_MAX_AGE="28800"
# Ceiling a session cannot be renewed past, however active (default 7d).
SESSION_ABSOLUTE_MAX_AGE="604800"

# --- App -----------------------------------------------------
NEXT_PUBLIC_APP_NAME="CareSync Hospital"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public origin used to build links inside emails. Set this in production
# or verification and reset links will point at localhost.
APP_ORIGIN=""
NODE_ENV="development"

# --- First administrator -------------------------------------
# A production database starts empty, so there is nobody to sign in as.
# Set a long random value, POST it once to /api/auth/bootstrap to create
# the first administrator, then REMOVE it. The endpoint refuses to run
# once any active administrator exists.
BOOTSTRAP_TOKEN=""

# --- Outbound email ------------------------------------------
# "console" records messages in memory instead of sending them, so the
# verification, invitation and password-reset flows are fully testable
# with no provider configured. "resend" needs RESEND_API_KEY; "smtp"
# needs SMTP_URL and the optional `nodemailer` package.
MAIL_DRIVER="console"
MAIL_FROM="CareSync Hospital <no-reply@caresync.local>"
RESEND_API_KEY=""
SMTP_URL=""

# --- Shared stores (horizontal scaling) ----------------------
# Absent: rate limiting is per-instance, and correct only on a single
# instance. Present (Upstash REST credentials): limits are shared and
# the application can be scaled out. See docs/SCALING.md.
REDIS_URL=""
REDIS_TOKEN=""

# --- AI layer (optional) -------------------------------------
# Leave AI_PROVIDER=heuristic to run the deterministic, offline
# summariser. Set to "anthropic" or "openai" and supply a key to
# use a hosted model. AI output is always advisory + human-reviewed.
AI_PROVIDER="heuristic"
AI_API_KEY=""
AI_MODEL=""

# --- File storage --------------------------------------------
# "database" (default, portable) | "local" (dev filesystem) | "supabase"
STORAGE_DRIVER="database"
STORAGE_MAX_FILE_MB="10"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="caresync-documents"

# --- Rate limiting -------------------------------------------
RATE_LIMIT_LOGIN_PER_MIN="10"
RATE_LIMIT_API_PER_MIN="300"
RATE_LIMIT_REGISTER_PER_HOUR="5"
RATE_LIMIT_RESET_PER_HOUR="5"

# --- Logging -------------------------------------------------
# One JSON object per line on stdout/stderr. Only allow-listed fields
# are written — no patient data ever reaches a log. debug | info | warn
# | error; defaults to info in production, debug elsewhere.
LOG_LEVEL=""

# --- Seeding (development only) ------------------------------
# `npm run db:seed` builds the demonstration hospital: invented patients,
# wards and staff. It is NOT run by the production build, and a
# deployment starts empty.
SEED_DEMO_PASSWORD="CareSync#2026"
# Set to "true" to allow seeding a non-empty database (destructive).
SEED_FORCE="false"

# --- Demonstration mode (development only) --------------------
# Shows the seeded accounts on the sign-in screen for one-click access.
# Anything other than the exact string "true" leaves it off, which is
# what any deployment holding real data must have.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS="false"
NEXT_PUBLIC_DEMO_PASSWORD=""
